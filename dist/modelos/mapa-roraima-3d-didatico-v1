<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Roraima 3D · Edição Didática</title>
<style>
  :root {
    --bg: #03060d;
    --panel: rgba(10, 15, 27, 0.82);
    --panel-border: rgba(255, 255, 255, 0.15);
    --text: #f6f8fd;
    --muted: #9eb0cf;
    --accent: #7ab8ff;
    --gold: #ffca6b;
    --emerald: #6ee7b7;
    --rose: #fda4af;
    --radius: 16px;
    --painel-w: 348px;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 100%; height: 100%; overflow: hidden; background: var(--bg); color: var(--text);
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; -webkit-user-select: none; user-select: none; }
  body { background: radial-gradient(ellipse at 40% 35%, #0d1830 0%, #050913 60%, #02040a 100%); }
  canvas#mapa { position: fixed; inset: 0; width: 100vw; height: 100vh; display: block; cursor: grab; touch-action: none; outline: none; }
  canvas#mapa:active { cursor: grabbing; }
  .glass { background: var(--panel); backdrop-filter: blur(18px) saturate(140%); -webkit-backdrop-filter: blur(18px) saturate(140%);
    border: 1px solid var(--panel-border); border-radius: var(--radius); box-shadow: 0 16px 40px rgba(0,0,0,.55), inset 0 1px 0 rgba(255,255,255,.08); }
  .topbar { position: fixed; top: 12px; left: 12px; right: 12px; display: flex; gap: 10px; align-items: flex-start; justify-content: space-between; pointer-events: none; z-index: 20; }
  .brand, .controles { pointer-events: auto; padding: 9px 13px; }
  .brand { display: flex; align-items: center; gap: 10px; }
  .brand i { width: 13px; height: 13px; border-radius: 4px; background: linear-gradient(135deg, #6ee7b7, #7ab8ff); box-shadow: 0 0 16px rgba(110,231,183,.7); flex: none; }
  .brand h1 { font-size: .92rem; font-weight: 700; letter-spacing: .02em; }
  .brand small { display: block; font-size: .68rem; color: var(--muted); font-weight: 400; }
  .controles { display: flex; flex-wrap: wrap; gap: 5px; align-items: center; justify-content: flex-end; max-width: calc(100% - 250px); }
  .controles .rot { font-size: .68rem; color: var(--muted); margin-right: 2px; }
  button { font: inherit; color: inherit; }
  button.btn { background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.13); border-radius: 10px; padding: 6px 10px; font-size: .73rem; font-weight: 500; cursor: pointer; min-height: 30px; }
  button.btn:hover { background: rgba(255,255,255,.12); }
  button.btn:focus-visible, .aba:focus-visible, .linha:focus-visible, .op:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  button.btn.on { background: rgba(122,184,255,.22); border-color: rgba(122,184,255,.7); color: #e8f2ff; }
  .painel { position: fixed; top: 76px; right: 12px; bottom: 12px; width: var(--painel-w); z-index: 15; display: flex; flex-direction: column; overflow: hidden; }
  .abas { display: flex; border-bottom: 1px solid rgba(255,255,255,.1); flex: none; }
  .aba { flex: 1; padding: 11px 4px; background: none; border: 0; font-size: .75rem; font-weight: 600; color: var(--muted); cursor: pointer; border-bottom: 2px solid transparent; }
  .aba[aria-selected="true"] { color: #fff; border-bottom-color: var(--accent); }
  .corpo { flex: 1; overflow-y: auto; padding: 14px 15px 16px; -webkit-user-select: text; user-select: text; }
  .corpo h2 { font-size: 1.15rem; line-height: 1.2; margin-bottom: 2px; }
  .corpo h3 { font-size: .78rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: 14px 0 6px; font-weight: 600; }
  .sub { font-size: .76rem; color: var(--muted); margin-bottom: 10px; }
  .selo { display: inline-block; font-size: .64rem; font-weight: 700; padding: 2px 7px; border-radius: 99px; background: rgba(255,202,107,.18); color: var(--gold); border: 1px solid rgba(255,202,107,.45); margin-left: 6px; vertical-align: middle; }
  .grade { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .dado { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08); border-radius: 12px; padding: 8px 10px; }
  .dado b { display: block; font-size: 1.02rem; font-weight: 700; }
  .dado span { font-size: .66rem; color: var(--muted); }
  .dado.larga { grid-column: 1 / -1; }
  .barra { height: 8px; border-radius: 99px; background: rgba(255,255,255,.09); overflow: hidden; margin-top: 5px; }
  .barra > i { display: block; height: 100%; border-radius: 99px; background: linear-gradient(90deg, #3b8bbd, #6ee7b7); }
  .nota { font-size: .78rem; line-height: 1.45; color: #dbe6fa; background: rgba(122,184,255,.09); border-left: 3px solid var(--accent); padding: 8px 10px; border-radius: 0 10px 10px 0; margin-top: 10px; }
  .aviso { font-size: .7rem; line-height: 1.4; color: var(--muted); margin-top: 12px; }
  p { font-size: .8rem; line-height: 1.5; color: #dbe6fa; margin-bottom: 8px; }
  .linha { display: grid; grid-template-columns: 22px 1fr auto; gap: 8px; align-items: center; width: 100%; text-align: left; background: none; border: 0; border-radius: 10px; padding: 6px 6px; cursor: pointer; }
  .linha:hover, .linha.sel { background: rgba(255,255,255,.08); }
  .linha .n { font-size: .7rem; color: var(--muted); text-align: right; }
  .linha .nome { font-size: .8rem; font-weight: 600; }
  .linha .val { font-size: .74rem; color: #cfe0ff; font-variant-numeric: tabular-nums; }
  .linha .barra { grid-column: 2 / 4; margin-top: 0; height: 6px; }
  .passos { display: flex; gap: 6px; margin: 10px 0; }
  .passos button { flex: 1; }
  .ponto { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,.2); display: inline-block; margin: 0 2px; }
  .ponto.on { background: var(--accent); }
  .op { display: block; width: 100%; text-align: left; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.13); border-radius: 11px; padding: 9px 11px; font-size: .8rem; margin-bottom: 7px; cursor: pointer; }
  .op:hover:not(:disabled) { background: rgba(255,255,255,.12); }
  .op.certa { background: rgba(110,231,183,.22); border-color: var(--emerald); }
  .op.errada { background: rgba(253,164,175,.2); border-color: var(--rose); }
  .op:disabled { cursor: default; }
  .placar { font-size: .74rem; color: var(--muted); display: flex; justify-content: space-between; margin-bottom: 8px; }
  .feedback { font-size: .8rem; line-height: 1.45; margin: 8px 0; padding: 8px 10px; border-radius: 10px; background: rgba(255,255,255,.06); }
  .modo { display: flex; gap: 6px; margin-bottom: 10px; }
  .modo .btn { flex: 1; }
  .legenda { position: fixed; left: 12px; bottom: 12px; z-index: 14; padding: 9px 12px; width: 250px; }
  .legenda .tit { font-size: .7rem; font-weight: 600; margin-bottom: 5px; }
  .legenda .gr { height: 9px; border-radius: 99px; background: linear-gradient(90deg, #24476b, #3b8bbd, #6ee7b7, #ffca6b); }
  .legenda .fx { display: flex; justify-content: space-between; font-size: .66rem; color: var(--muted); margin-top: 3px; }
  .legenda .sd { font-size: .66rem; color: var(--muted); margin-top: 5px; display: flex; align-items: center; gap: 6px; }
  .legenda .sd i { width: 10px; height: 10px; border-radius: 3px; background: #4a5160; display: inline-block; }
  .legenda .dica { font-size: .64rem; color: var(--muted); margin-top: 6px; line-height: 1.35; }
  #dica { position: fixed; z-index: 30; pointer-events: none; padding: 6px 9px; font-size: .74rem; border-radius: 9px; display: none; white-space: nowrap; }
  #dica b { display: block; font-size: .8rem; }
  @media (max-width: 820px) {
    .painel { top: auto; left: 8px; right: 8px; bottom: 8px; width: auto; height: 44vh; }
    .controles button.btn { padding: 4px 8px; font-size: .68rem; min-height: 28px; }
    .controles .rot { display: none; }
    .painel.baixo { height: 46px; }
    .painel.baixo .corpo { display: none; }
    .topbar { top: 8px; left: 8px; right: 8px; flex-direction: column; gap: 6px; }
    .controles { max-width: 100%; justify-content: flex-start; }
    .legenda { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
